+// walk_strip_for returns the walking animation for a row image "<name>.png": "<name>.walk.png", a strip of
+// frames each the size of the still image, scaled like it (cached for one image at a time), or NULL.
+static SDL_Surface *walk_strip = NULL;
+static char walk_strip_path[1024] = "";
+static int walk_strip_frames = 0;
+static SDL_Surface *walk_strip_for(const char *image_path, SDL_Surface *still)
+{
+    char path[1024];
+    size_t len = strlen(image_path);
+    if (len < 4 || len + 6 >= sizeof(path) || strcmp(image_path + len - 4, ".png") != 0)
+        return NULL;
+    snprintf(path, sizeof(path), "%.*s.walk.png", (int)(len - 4), image_path);
+    if (strcmp(path, walk_strip_path) == 0 && (walk_strip == NULL || walk_strip->h == still->h))
+        return walk_strip;
+    if (walk_strip != NULL)
+        SDL_FreeSurface(walk_strip);
+    walk_strip = NULL;
+    strncpy(walk_strip_path, path, sizeof(walk_strip_path) - 1);
+    SDL_Surface *loaded = IMG_Load(path);
+    if (loaded == NULL || loaded->h == 0 || still->w == 0)
+    {
+        if (loaded != NULL)
+            SDL_FreeSurface(loaded);
+        return NULL;
+    }
+    walk_strip_frames = (int)(((long)loaded->w * still->h * 2 / ((long)loaded->h * still->w) + 1) / 2);
+    if (walk_strip_frames < 1)
+        walk_strip_frames = 1;
+    walk_strip = SDL_CreateRGBSurfaceWithFormat(0, still->w * walk_strip_frames, still->h, 32, SDL_PIXELFORMAT_RGBA32);
+    if (walk_strip != NULL)
+    {
+        SDL_SetSurfaceBlendMode(loaded, SDL_BLENDMODE_NONE);
+        SDL_BlitScaled(loaded, NULL, walk_strip, NULL);
+        SDL_SetSurfaceBlendMode(walk_strip, SDL_BLENDMODE_BLEND);
+    }
+    SDL_FreeSurface(loaded);
+    return walk_strip;
+}
