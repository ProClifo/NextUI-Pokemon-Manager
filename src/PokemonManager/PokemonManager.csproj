<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>pkmgr</AssemblyName>
    <RootNamespace>PokemonManager</RootNamespace>
    <Version>0.1.0</Version>
    <!-- The handhelds ship without ICU; PKHeX only needs invariant culture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- The trimmed device build has no reflection-based JSON; run every build that way so tests catch it. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Code that needs reflection breaks in the trimmed device build: fail the build instead. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2067;IL2070;IL2072;IL2075;IL2080;IL2087;IL3050</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PKHeX.Core" Version="26.8.26" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PokemonManager.Tests" />
  </ItemGroup>

</Project>
