<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>pkmgr</AssemblyName>
    <RootNamespace>PokemonManager</RootNamespace>
    <Version>0.1.0</Version>
    <!-- The handhelds ship without ICU; PKHeX only needs invariant culture. -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PKHeX.Core" Version="26.8.26" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PokemonManager.Tests" />
  </ItemGroup>

</Project>
